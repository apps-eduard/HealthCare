# syntax=docker/dockerfile:1.7

ARG DOTNET_VERSION=10.0

FROM mcr.microsoft.com/dotnet/sdk:${DOTNET_VERSION} AS build
WORKDIR /src
ARG GIT_SHA=unknown
COPY Directory.Build.props ./
COPY HealthCare.sln ./
COPY src/HealthCare.Contracts/HealthCare.Contracts.csproj src/HealthCare.Contracts/
COPY src/HealthCare.Domain/HealthCare.Domain.csproj src/HealthCare.Domain/
COPY src/HealthCare.Application/HealthCare.Application.csproj src/HealthCare.Application/
COPY src/HealthCare.Infrastructure/HealthCare.Infrastructure.csproj src/HealthCare.Infrastructure/
COPY src/HealthCare.Api/HealthCare.Api.csproj src/HealthCare.Api/
RUN dotnet restore src/HealthCare.Api/HealthCare.Api.csproj
COPY src/HealthCare.Contracts/ src/HealthCare.Contracts/
COPY src/HealthCare.Domain/ src/HealthCare.Domain/
COPY src/HealthCare.Application/ src/HealthCare.Application/
COPY src/HealthCare.Infrastructure/ src/HealthCare.Infrastructure/
COPY src/HealthCare.Api/ src/HealthCare.Api/
RUN dotnet publish src/HealthCare.Api/HealthCare.Api.csproj -c Release -o /app/publish /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:${DOTNET_VERSION} AS final
WORKDIR /app
ARG GIT_SHA=unknown
LABEL org.opencontainers.image.title="healthcare-api" \
      org.opencontainers.image.description="HealthCare API" \
      org.opencontainers.image.revision="${GIT_SHA}" \
      org.opencontainers.image.source="https://github.com/local/HealthCare"
ENV ASPNETCORE_URLS=http://+:8080 \
    DOTNET_EnableDiagnostics=0
# Official ASP.NET images already include a non-root `app` user.
USER app
COPY --from=build --chown=app:app /app/publish .
EXPOSE 8080
ENTRYPOINT ["dotnet", "HealthCare.Api.dll"]
