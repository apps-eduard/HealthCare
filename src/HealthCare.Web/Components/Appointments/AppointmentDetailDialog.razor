@namespace HealthCare.Web.Components.Appointments
@inherits FeedbackComponent<AppointmentDetailDialog.Args>
@using HealthCare.Contracts.Appointments
@using HealthCare.Contracts.MedicalNotes
@using HealthCare.Web.Appointments
@using HealthCare.Web.MedicalNotes
@using HealthCare.Web.Operations

@if (_loading)
{
    <PageLoading />
}
else if (_appointment is null)
{
    <Alert Type="@AlertType.Error" Message="@(_error ?? "Appointment not found.")" ShowIcon="true" />
}
else
{
    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <Alert Type="@AlertType.Error" Message="@_error" ShowIcon="true" Style="margin-bottom:0.75rem;" />
    }

    <div style="display:flex;flex-direction:column;gap:8px;">
        <div class="hc-caption">ID: @_appointment.Id</div>
        <div><strong>When:</strong> @ClinicTimeDisplay.FormatLocalWithZone(_appointment.AppointmentDateUtc, _appointment.ClinicTimeZoneId)</div>
        <div><strong>Duration:</strong> @_appointment.DurationMinutes min</div>
        <div>
            <strong>Status:</strong>
            <StatusBadge Text="@AppointmentStatusPresentation.DisplayLabel(_appointment.Status)"
                         Tone="@AppointmentStatusPresentation.ChipTone(_appointment.Status)" />
        </div>
        <div><strong>Clinic:</strong> @(_appointment.ClinicName ?? _appointment.ClinicId.ToString("D"))</div>
        <div><strong>Doctor:</strong> @(_appointment.DoctorDisplayName ?? "—")</div>
        <div>
            <strong>Patient:</strong>
            @(_appointment.PatientDisplayName ?? "—")
            @if (!string.IsNullOrWhiteSpace(_appointment.LocalPatientNumber))
            {
                <span> · @_appointment.LocalPatientNumber</span>
            }
        </div>
        <div><strong>Source:</strong> @_appointment.Source</div>
        <div><strong>Version:</strong> @_appointment.Version</div>
        <div class="hc-caption">Created: @ClinicTimeDisplay.FormatLocalWithZone(_appointment.CreatedAtUtc, _appointment.ClinicTimeZoneId)</div>
        <div class="hc-caption">Updated: @ClinicTimeDisplay.FormatLocalWithZone(_appointment.UpdatedAtUtc, _appointment.ClinicTimeZoneId)</div>
        @if (!string.IsNullOrWhiteSpace(_appointment.CancellationReason))
        {
            <div><strong>Cancellation reason:</strong> @_appointment.CancellationReason</div>
        }

        @if (OperationsPermissionRules.CanViewReminders(Permissions))
        {
            <h4 style="font-size:0.95rem;margin:0.75rem 0 0.5rem;">Reminders</h4>
            @if (_remindersLoading)
            {
                <PageLoading />
            }
            else if (_reminders.Count == 0)
            {
                <div class="hc-caption">No reminders for this appointment.</div>
            }
            else
            {
                <div class="hc-table-wrap">
                    <table class="hc-table" aria-label="Appointment reminders">
                        <thead>
                            <tr>
                                <th>Type</th>
                                <th>Status</th>
                                <th>Attempts</th>
                                <th>Scheduled (UTC)</th>
                                @if (OperationsPermissionRules.CanRetryReminders(Permissions))
                                {
                                    <th class="hc-actions">Actions</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var reminder in _reminders)
                        {
                            <tr>
                                <td>@ReminderStatusPresentation.TypeLabel(reminder.ReminderType)</td>
                                <td>
                                    <StatusBadge Text="@ReminderStatusPresentation.DisplayLabel(reminder.Status)"
                                                 Tone="@ReminderStatusPresentation.ChipTone(reminder.Status)" />
                                </td>
                                <td>@reminder.AttemptCount</td>
                                <td><span class="hc-caption">@reminder.ScheduledAtUtc.UtcDateTime.ToString("u")</span></td>
                                @if (OperationsPermissionRules.CanRetryReminders(Permissions))
                                {
                                    <td class="hc-actions">
                                        @if (ReminderStatusPresentation.AppearsRetryable(reminder.Status))
                                        {
                                            <Button Type="@ButtonType.Link"
                                                    Disabled="_busy"
                                                    OnClick="@(() => RetryReminderAsync(reminder))"
                                                    AriaLabel="Retry reminder">
                                                Retry
                                            </Button>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        }

        @if (MedicalNotePermissionRules.CanView(Permissions))
        {
            <h4 style="font-size:0.95rem;margin:0.75rem 0 0.5rem;">Medical notes</h4>
            @if (_notesLoading)
            {
                <PageLoading />
            }
            else
            {
                @if (_notes.Count == 0)
                {
                    <div class="hc-caption">No notes authored by you for this appointment.</div>
                }
                else
                {
                    <div class="hc-table-wrap">
                        <table class="hc-table" aria-label="Medical notes">
                            <thead>
                                <tr>
                                    <th>Type</th>
                                    <th>Status</th>
                                    <th>Updated</th>
                                    <th class="hc-actions">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var note in _notes)
                            {
                                <tr>
                                    <td>@note.NoteType</td>
                                    <td>@note.Status</td>
                                    <td><span class="hc-caption">@note.UpdatedAtUtc.UtcDateTime.ToString("u")</span></td>
                                    <td class="hc-actions">
                                        <Button Type="@ButtonType.Link"
                                                Disabled="_busy"
                                                OnClick="@(() => OpenNoteAsync(note.Id))"
                                                AriaLabel="Open medical note">
                                            Open
                                        </Button>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }

                @if (MedicalNotePermissionRules.CanCreate(Permissions)
                     && AppointmentStatusPresentation.AllowsMedicalNoteCreate(_appointment.Status))
                {
                    <Button Type="@ButtonType.Default"
                            Disabled="_busy"
                            Style="margin-top:0.5rem;"
                            OnClick="CreateDraftNoteAsync"
                            AriaLabel="Create medical note draft">
                        New draft note
                    </Button>
                }

                @if (_selectedNote is not null)
                {
                    <div style="margin-top:0.75rem;padding-top:0.75rem;border-top:1px solid var(--hc-border, #e5e7eb);">
                        <div class="hc-caption">@_selectedNote.NoteType · @_selectedNote.Status · v@_selectedNote.Version</div>
                        @if (string.Equals(_selectedNote.Status, "Draft", StringComparison.OrdinalIgnoreCase)
                             && MedicalNotePermissionRules.CanUpdateDraft(Permissions))
                        {
                            <div style="display:flex;flex-direction:column;gap:6px;margin-top:0.5rem;">
                                <label class="hc-caption" for="medical-note-subjective">Subjective</label>
                                <textarea id="medical-note-subjective"
                                          class="ant-input"
                                          rows="2"
                                          placeholder="Subjective"
                                          aria-label="Subjective"
                                          @bind="_noteSubjective"
                                          @bind:event="oninput"></textarea>
                                <label class="hc-caption" for="medical-note-objective">Objective</label>
                                <textarea id="medical-note-objective"
                                          class="ant-input"
                                          rows="2"
                                          placeholder="Objective"
                                          aria-label="Objective"
                                          @bind="_noteObjective"
                                          @bind:event="oninput"></textarea>
                                <label class="hc-caption" for="medical-note-assessment">Assessment</label>
                                <textarea id="medical-note-assessment"
                                          class="ant-input"
                                          rows="2"
                                          placeholder="Assessment"
                                          aria-label="Assessment"
                                          @bind="_noteAssessment"
                                          @bind:event="oninput"></textarea>
                                <label class="hc-caption" for="medical-note-plan">Plan</label>
                                <textarea id="medical-note-plan"
                                          class="ant-input"
                                          rows="2"
                                          placeholder="Plan"
                                          aria-label="Plan"
                                          @bind="_notePlan"
                                          @bind:event="oninput"></textarea>
                            </div>
                            <Space Style="margin-top:0.5rem;">
                                <Button Disabled="_busy" OnClick="SaveDraftNoteAsync" AriaLabel="Save medical note draft">Save draft</Button>
                                @if (MedicalNotePermissionRules.CanSign(Permissions))
                                {
                                    <Button Type="@ButtonType.Primary" Disabled="_busy" OnClick="SignNoteAsync" AriaLabel="Sign medical note">Sign</Button>
                                }
                            </Space>
                        }
                        else
                        {
                            <div style="margin-top:0.5rem;display:flex;flex-direction:column;gap:4px;">
                                <div><strong>S:</strong> @(_selectedNote.Subjective ?? "—")</div>
                                <div><strong>O:</strong> @(_selectedNote.Objective ?? "—")</div>
                                <div><strong>A:</strong> @(_selectedNote.Assessment ?? "—")</div>
                                <div><strong>P:</strong> @(_selectedNote.Plan ?? "—")</div>
                            </div>
                            @if (string.Equals(_selectedNote.Status, "Signed", StringComparison.OrdinalIgnoreCase)
                                 && MedicalNotePermissionRules.CanAmend(Permissions))
                            {
                                <div style="margin-top:0.5rem;display:flex;flex-direction:column;gap:6px;">
                                    <label class="hc-caption" for="medical-note-amend-reason">Amendment reason</label>
                                    <input id="medical-note-amend-reason"
                                           class="ant-input"
                                           placeholder="Amendment reason"
                                           aria-label="Amendment reason"
                                           @bind="_amendReason"
                                           @bind:event="oninput" />
                                    <label class="hc-caption" for="medical-note-amend-plan">Amendment plan</label>
                                    <textarea id="medical-note-amend-plan"
                                              class="ant-input"
                                              rows="2"
                                              placeholder="Updated plan (optional)"
                                              aria-label="Amendment plan"
                                              @bind="_amendPlan"
                                              @bind:event="oninput"></textarea>
                                    <Button Disabled="_busy" OnClick="AmendNoteAsync" AriaLabel="Amend medical note">Amend</Button>
                                </div>
                            }
                        }
                    </div>
                }
            }
        }
    </div>
}

<div style="display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end;margin-top:1rem;">
    <Button OnClick="CloseAsync" Disabled="_busy">Close</Button>
    @if (_appointment is not null)
    {
        @foreach (var action in AppointmentActionRules.GetVisibleActions(_appointment.Status, Permissions))
        {
            <Button Type="@ButtonType.Primary"
                    Disabled="_busy"
                    OnClick="@(() => RunActionAsync(action))"
                    AriaLabel="@ActionLabel(action)">
                @ActionLabel(action)
            </Button>
        }
    }
</div>

@code {
    public sealed class Args
    {
        public Guid AppointmentId { get; init; }
        public bool PlatformAdminBypass { get; init; }
    }

    [Inject] private IAppointmentApiClient AppointmentsApi { get; set; } = default!;
    [Inject] private IStaffOperationsApiClient OperationsApi { get; set; } = default!;
    [Inject] private IMedicalNoteApiClient NotesApi { get; set; } = default!;
    [Inject] private IPermissionState Permissions { get; set; } = default!;
    [Inject] private IUiModalService Modals { get; set; } = default!;
    [Inject] private IUserNotificationService Notify { get; set; } = default!;

    private AppointmentResponse? _appointment;
    private readonly List<AppointmentReminderResponse> _reminders = [];
    private readonly List<MedicalNoteSummaryResponse> _notes = [];
    private MedicalNoteDetailResponse? _selectedNote;
    private bool _loading = true;
    private bool _remindersLoading;
    private bool _notesLoading;
    private bool _busy;
    private string? _error;
    private bool _changed;
    private string? _noteSubjective;
    private string? _noteObjective;
    private string? _noteAssessment;
    private string? _notePlan;
    private string? _amendReason;
    private string? _amendPlan;

    private Guid AppointmentId => Options.AppointmentId;
    private bool PlatformAdminBypass => Options.PlatformAdminBypass;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _appointment = await AppointmentsApi.GetByIdAsync(AppointmentId, PlatformAdminBypass);
            await LoadRemindersAsync();
            await LoadNotesAsync();
        }
        catch (ApiProblemException ex)
        {
            _appointment = null;
            _error = AppointmentProblemMessages.ToUserMessage(ex);
            _reminders.Clear();
            _notes.Clear();
            _selectedNote = null;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadRemindersAsync()
    {
        _reminders.Clear();
        if (!OperationsPermissionRules.CanViewReminders(Permissions) || _appointment is null)
        {
            return;
        }

        _remindersLoading = true;
        try
        {
            var items = await OperationsApi.ListAppointmentRemindersAsync(_appointment.Id, PlatformAdminBypass);
            _reminders.AddRange(items.OrderBy(r => r.ScheduledAtUtc));
        }
        catch (ApiProblemException)
        {
            // Appointment detail remains usable if reminder list fails.
        }
        finally
        {
            _remindersLoading = false;
        }
    }

    private async Task LoadNotesAsync()
    {
        _notes.Clear();
        _selectedNote = null;
        if (!MedicalNotePermissionRules.CanView(Permissions) || _appointment is null)
        {
            return;
        }

        _notesLoading = true;
        try
        {
            var items = await NotesApi.ListForAppointmentAsync(_appointment.Id);
            _notes.AddRange(items.OrderByDescending(n => n.UpdatedAtUtc));
        }
        catch (ApiProblemException)
        {
            // Appointment detail remains usable if note list fails.
        }
        finally
        {
            _notesLoading = false;
        }
    }

    private async Task CreateDraftNoteAsync()
    {
        if (_busy || _appointment is null || !MedicalNotePermissionRules.CanCreate(Permissions))
        {
            return;
        }

        _busy = true;
        try
        {
            var created = await NotesApi.CreateDraftAsync(_appointment.Id, new CreateMedicalNoteDraftRequest
            {
                NoteType = "Progress",
                Plan = "Initial plan",
            });
            Notify.Success("Draft note created.");
            _changed = true;
            _selectedNote = created;
            _noteSubjective = created.Subjective;
            _noteObjective = created.Objective;
            _noteAssessment = created.Assessment;
            _notePlan = created.Plan;
            _amendReason = null;
            _amendPlan = null;
            _busy = false;
            await InvokeAsync(StateHasChanged);
            await LoadNotesAsync();
        }
        catch (ApiProblemException ex)
        {
            Notify.Error(MedicalNoteProblemMessages.ToUserMessage(ex));
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task OpenNoteAsync(Guid noteId)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        try
        {
            await SelectNoteAsync(noteId);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SelectNoteAsync(Guid noteId)
    {
        try
        {
            _selectedNote = await NotesApi.GetByIdAsync(noteId);
            _noteSubjective = _selectedNote.Subjective;
            _noteObjective = _selectedNote.Objective;
            _noteAssessment = _selectedNote.Assessment;
            _notePlan = _selectedNote.Plan;
            _amendReason = null;
            _amendPlan = null;
        }
        catch (ApiProblemException ex)
        {
            _selectedNote = null;
            Notify.Error(MedicalNoteProblemMessages.ToUserMessage(ex));
        }
    }

    private async Task SaveDraftNoteAsync()
    {
        if (_busy || _selectedNote is null || !MedicalNotePermissionRules.CanUpdateDraft(Permissions))
        {
            return;
        }

        _busy = true;
        try
        {
            _selectedNote = await NotesApi.UpdateDraftAsync(_selectedNote.Id, new UpdateMedicalNoteDraftRequest
            {
                ExpectedVersion = _selectedNote.Version,
                Subjective = _noteSubjective,
                Objective = _noteObjective,
                Assessment = _noteAssessment,
                Plan = _notePlan,
            });
            Notify.Success("Draft note saved.");
            _changed = true;
            _noteSubjective = _selectedNote.Subjective;
            _noteObjective = _selectedNote.Objective;
            _noteAssessment = _selectedNote.Assessment;
            _notePlan = _selectedNote.Plan;
            _busy = false;
            await InvokeAsync(StateHasChanged);
            await LoadNotesAsync();
        }
        catch (ApiProblemException ex) when (MedicalNoteProblemMessages.IsConcurrencyConflict(ex))
        {
            Notify.Warning(MedicalNoteProblemMessages.ToUserMessage(ex));
            await SelectNoteAsync(_selectedNote.Id);
        }
        catch (ApiProblemException ex)
        {
            Notify.Error(MedicalNoteProblemMessages.ToUserMessage(ex));
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SignNoteAsync()
    {
        if (_busy || _selectedNote is null || !MedicalNotePermissionRules.CanSign(Permissions))
        {
            return;
        }

        if (!await Modals.ConfirmAsync("Sign note", "Sign this draft note? It becomes immutable."))
        {
            return;
        }

        _busy = true;
        try
        {
            _selectedNote = await NotesApi.SignAsync(_selectedNote.Id, new SignMedicalNoteRequest
            {
                ExpectedVersion = _selectedNote.Version,
            });
            Notify.Success("Note signed.");
            _changed = true;
            _busy = false;
            await InvokeAsync(StateHasChanged);
            await LoadNotesAsync();
        }
        catch (ApiProblemException ex) when (MedicalNoteProblemMessages.IsConcurrencyConflict(ex))
        {
            Notify.Warning(MedicalNoteProblemMessages.ToUserMessage(ex));
            await SelectNoteAsync(_selectedNote.Id);
        }
        catch (ApiProblemException ex)
        {
            Notify.Error(MedicalNoteProblemMessages.ToUserMessage(ex));
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task AmendNoteAsync()
    {
        if (_busy || _selectedNote is null || !MedicalNotePermissionRules.CanAmend(Permissions))
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_amendReason))
        {
            Notify.Warning("Amendment reason is required.");
            return;
        }

        _busy = true;
        try
        {
            _selectedNote = await NotesApi.AmendAsync(_selectedNote.Id, new AmendMedicalNoteRequest
            {
                ExpectedVersion = _selectedNote.Version,
                AmendmentReason = _amendReason.Trim(),
                Plan = string.IsNullOrWhiteSpace(_amendPlan) ? null : _amendPlan,
            });
            Notify.Success("Amendment signed.");
            _changed = true;
            _amendReason = null;
            _amendPlan = null;
            _busy = false;
            await InvokeAsync(StateHasChanged);
            await LoadNotesAsync();
        }
        catch (ApiProblemException ex) when (MedicalNoteProblemMessages.IsConcurrencyConflict(ex))
        {
            Notify.Warning(MedicalNoteProblemMessages.ToUserMessage(ex));
            await SelectNoteAsync(_selectedNote.Id);
        }
        catch (ApiProblemException ex)
        {
            Notify.Error(MedicalNoteProblemMessages.ToUserMessage(ex));
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RetryReminderAsync(AppointmentReminderResponse reminder)
    {
        if (_busy || !OperationsPermissionRules.CanRetryReminders(Permissions))
        {
            return;
        }

        if (!await Modals.ConfirmAsync(
                "Retry reminder",
                $"Retry {ReminderStatusPresentation.TypeLabel(reminder.ReminderType)} reminder?"))
        {
            return;
        }

        _busy = true;
        try
        {
            await OperationsApi.RetryReminderAsync(reminder.AppointmentId, reminder.Id, PlatformAdminBypass);
            Notify.Success("Reminder queued for retry.");
            _changed = true;
            await LoadRemindersAsync();
        }
        catch (ApiProblemException ex) when (ReminderProblemMessages.IsRetryConflict(ex))
        {
            Notify.Warning(ReminderProblemMessages.ToUserMessage(ex));
            await LoadRemindersAsync();
        }
        catch (ApiProblemException ex)
        {
            Notify.Error(ReminderProblemMessages.ToUserMessage(ex));
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RunActionAsync(AppointmentUiAction action)
    {
        if (_appointment is null || _busy)
        {
            return;
        }

        switch (action)
        {
            case AppointmentUiAction.Cancel:
                await OpenCancelAsync();
                return;
            case AppointmentUiAction.Reschedule:
                await OpenRescheduleAsync();
                return;
        }

        var confirmed = await Modals.ConfirmAsync(
            ActionLabel(action),
            ConfirmMessage(action));
        if (!confirmed)
        {
            return;
        }

        await MutateAsync(action);
    }

    private string ConfirmMessage(AppointmentUiAction action) =>
        action switch
        {
            AppointmentUiAction.Complete =>
                "Complete this appointment? This cannot be undone. A medical note is not required.",
            AppointmentUiAction.NoShow =>
                "Mark this appointment as no-show? This cannot be undone.",
            AppointmentUiAction.CheckIn =>
                "Check in this appointment?",
            AppointmentUiAction.Confirm =>
                "Confirm this appointment?",
            _ => $"Confirm {ActionLabel(action).ToLowerInvariant()} for this appointment?",
        };

    private async Task MutateAsync(AppointmentUiAction action)
    {
        if (_appointment is null)
        {
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            var request = new AppointmentActionRequest { ExpectedVersion = _appointment.Version };
            _appointment = action switch
            {
                AppointmentUiAction.Confirm => await AppointmentsApi.ConfirmAsync(_appointment.Id, request, PlatformAdminBypass),
                AppointmentUiAction.CheckIn => await AppointmentsApi.CheckInAsync(_appointment.Id, request, PlatformAdminBypass),
                AppointmentUiAction.Complete => await AppointmentsApi.CompleteAsync(_appointment.Id, request, PlatformAdminBypass),
                AppointmentUiAction.NoShow => await AppointmentsApi.MarkNoShowAsync(_appointment.Id, request, PlatformAdminBypass),
                _ => _appointment,
            };
            _changed = true;
            Notify.Success($"{ActionLabel(action)} succeeded.");
            if (MedicalNotePermissionRules.CanView(Permissions))
            {
                await LoadNotesAsync();
            }
        }
        catch (ApiProblemException ex) when (AppointmentProblemMessages.RequiresReload(ex))
        {
            var reload = await Modals.ConfirmAsync(
                "Appointment changed",
                AppointmentProblemMessages.IsInvalidTransition(ex)
                    ? "This status change is no longer valid. Reload the latest appointment state?"
                    : "This appointment was updated elsewhere. Reload the latest version?");
            if (reload)
            {
                await LoadAsync();
            }
            else
            {
                _error = AppointmentProblemMessages.ToUserMessage(ex);
            }
        }
        catch (ApiProblemException ex)
        {
            _error = AppointmentProblemMessages.ToUserMessage(ex);
            Notify.Error(_error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task OpenCancelAsync()
    {
        if (_appointment is null)
        {
            return;
        }

        var ok = await Modals.ShowAsync<CancelAppointmentDialog, CancelAppointmentDialog.Args>(
            "Cancel appointment",
            new CancelAppointmentDialog.Args
            {
                AppointmentId = _appointment.Id,
                ExpectedVersion = _appointment.Version,
                PlatformAdminBypass = PlatformAdminBypass,
            });
        if (ok)
        {
            _changed = true;
            await LoadAsync();
        }
    }

    private async Task OpenRescheduleAsync()
    {
        if (_appointment is null)
        {
            return;
        }

        var ok = await Modals.ShowAsync<RescheduleAppointmentDialog, RescheduleAppointmentDialog.Args>(
            "Reschedule appointment",
            new RescheduleAppointmentDialog.Args
            {
                Appointment = _appointment,
                PlatformAdminBypass = PlatformAdminBypass,
            },
            "560px");
        if (ok)
        {
            _changed = true;
            await LoadAsync();
        }
    }

    private Task ConfirmOkAsync() => OkCancelRef!.OkAsync(new ModalClosingEventArgs());

    private Task CancelCloseAsync() => OkCancelRef!.CancelAsync(new ModalClosingEventArgs());

    private Task CloseAsync() => _changed ? ConfirmOkAsync() : CancelCloseAsync();

    private static string ActionLabel(AppointmentUiAction action) => action switch
    {
        AppointmentUiAction.Confirm => "Confirm",
        AppointmentUiAction.CheckIn => "Check in",
        AppointmentUiAction.Complete => "Complete",
        AppointmentUiAction.NoShow => "No-show",
        AppointmentUiAction.Cancel => "Cancel",
        AppointmentUiAction.Reschedule => "Reschedule",
        _ => action.ToString(),
    };
}
