@page "/organization/settings"
@attribute [Authorize]
@using HealthCare.Contracts.Clinics
@using HealthCare.Contracts.Organizations
@using HealthCare.Web.OrganizationSettings
@implements IDisposable
@inject IOrganizationSettingsApiClient SettingsApi
@inject IClinicManagementApiClient ClinicsApi
@inject IPermissionState Permissions
@inject IPlatformTenantContext PlatformTenant
@inject IUserNotificationService Notify
@inject NavigationManager Navigation

<PageTitle>Organization Profile</PageTitle>

@if (Permissions.IsPatientOnly)
{
    <Alert Type="@AlertType.Error" Message="Patient accounts cannot use organization profile settings." ShowIcon="true" />
}
else if (!OrganizationSettingsPermissionRules.CanView(Permissions))
{
    <PermissionDeniedState Message="You do not have permission to view organization profile settings." />
}
else
{
    <HcPageHeader Title="Organization Profile"
                  Subtitle="@(_subtitle ?? "Organization contact details and operational defaults")">
        <Breadcrumb>
            <Breadcrumb>
                <BreadcrumbItem Href="/dashboard">Home</BreadcrumbItem>
                <BreadcrumbItem>Organization</BreadcrumbItem>
                <BreadcrumbItem>Organization Profile</BreadcrumbItem>
            </Breadcrumb>
        </Breadcrumb>
        <ChildContent>
            <Button OnClick="LoadAsync" Disabled="_loading || _saving" AriaLabel="Refresh organization profile">
                <Icon Type="reload" Theme="IconThemeType.Outline" /> Refresh
            </Button>
        </ChildContent>
    </HcPageHeader>

    @if (Permissions.IsPlatformAdmin && !PlatformTenant.HasOrganization)
    {
        <Alert Type="@AlertType.Info"
               Message="Select an organization in the platform banner before loading profile settings."
               ShowIcon="true"
               Style="margin-bottom:1rem;" />
    }

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <ErrorState Message="@_error" />
    }

    @if (_loading && _settings is null)
    {
        <PageLoading />
    }
    else if (_settings is null)
    {
        <EmptyState Message="Load organization profile to view settings." />
    }
    else
    {
        <div class="hc-card" style="margin-bottom:1rem;">
            <AntDesign.Row Gutter="(16, 16)" Align="RowAlign.Middle">
                <AntDesign.Col Xs="24" Md="14">
                    <div class="hc-caption" style="margin-bottom:4px;text-transform:uppercase;letter-spacing:0.04em;">Organization summary</div>
                    <h2 style="margin:0 0 0.5rem;font-size:1.25rem;">@_settings.Name</h2>
                    <div class="hc-caption">Slug: @_settings.Slug (read-only)</div>
                    <div class="hc-caption" style="margin-top:0.35rem;">
                        Created @_settings.CreatedAtUtc.UtcDateTime:u · Updated @_settings.UpdatedAtUtc.UtcDateTime:u (UTC)
                    </div>
                </AntDesign.Col>
                <AntDesign.Col Xs="24" Md="10" Style="text-align:right;">
                    <StatusBadge Text="@_settings.Status" Tone="@OrganizationSettingsPresentation.StatusTone(_settings.Status)" />
                    <div class="hc-caption" style="margin-top:0.5rem;">Status is read-only</div>
                </AntDesign.Col>
            </AntDesign.Row>
        </div>

        <AntDesign.Row Gutter="(16, 16)">
            <AntDesign.Col Xs="24" Lg="14">
                <div class="hc-card" style="margin-bottom:1rem;">
                    <h3 style="margin:0 0 0.75rem;font-size:1rem;">Profile</h3>
                    @if (_concurrencyConflict)
                    {
                        <Alert Type="@AlertType.Error"
                               Message="Another change was saved first. Reload the latest profile before saving again."
                               ShowIcon="true"
                               Style="margin-bottom:0.75rem;" />
                        <Button OnClick="LoadAsync" Disabled="_loading || _saving" Style="margin-bottom:0.75rem;" AriaLabel="Reload latest organization profile">
                            Reload latest
                        </Button>
                    }
                    @if (!CanEdit)
                    {
                        <Alert Type="@AlertType.Info"
                               Message="You can view this profile. Updating requires organization_profile.update."
                               ShowIcon="true"
                               Style="margin-bottom:0.75rem;" />
                    }
                    <div style="display:flex;flex-direction:column;gap:12px;">
                        <div>
                            <label for="org-settings-name">@FieldLabel.Mark("Organization name")</label>
                            <Input Id="org-settings-name"
                                   @bind-Value="_form.Name"
                                   Disabled="@(!CanEdit || _saving || _concurrencyConflict)"
                                   Style="width:100%;"
                                   AriaLabel="Organization name" />
                        </div>
                        <div>
                            <label for="org-settings-email">Contact email</label>
                            <Input Id="org-settings-email"
                                   @bind-Value="_form.ContactEmail"
                                   Disabled="@(!CanEdit || _saving || _concurrencyConflict)"
                                   Style="width:100%;"
                                   AriaLabel="Contact email" />
                        </div>
                        <div>
                            <label for="org-settings-phone">Contact phone</label>
                            <Input Id="org-settings-phone"
                                   @bind-Value="_form.ContactPhone"
                                   Disabled="@(!CanEdit || _saving || _concurrencyConflict)"
                                   Style="width:100%;"
                                   AriaLabel="Contact phone" />
                        </div>
                        <div>
                            <label for="org-settings-country">Country</label>
                            <Input Id="org-settings-country"
                                   @bind-Value="_form.Country"
                                   Disabled="@(!CanEdit || _saving || _concurrencyConflict)"
                                   Style="width:100%;"
                                   AriaLabel="Country" />
                        </div>
                        <div>
                            <label for="org-settings-tz">Default operational timezone</label>
                            <Select @bind-Value="_form.DefaultTimeZoneId"
                                    Id="org-settings-tz"
                                    Disabled="@(!CanEdit || _saving || _concurrencyConflict || _timeZonesLoading)"
                                    Style="width:100%;"
                                    TItemValue="string"
                                    TItem="string"
                                    AllowClear="true"
                                    Placeholder="Optional organization default"
                                    AriaLabel="Default operational timezone">
                                <SelectOptions>
                                    @foreach (var tz in _timeZones)
                                    {
                                        <SelectOption TItemValue="string" TItem="string" Value="@tz.TimeZoneId" Label="@($"{tz.DisplayName} ({tz.TimeZoneId})")" />
                                    }
                                </SelectOptions>
                            </Select>
                            <div class="hc-caption" style="margin-top:0.35rem;">
                                Clinic timezones remain authoritative for scheduling.
                            </div>
                        </div>
                        <div>
                            <label for="org-settings-branding">Branding placeholder</label>
                            <Input Id="org-settings-branding"
                                   @bind-Value="_form.BrandingPlaceholder"
                                   Disabled="@(!CanEdit || _saving || _concurrencyConflict)"
                                   Style="width:100%;"
                                   AriaLabel="Branding placeholder text" />
                            <div class="hc-caption" style="margin-top:0.35rem;">
                                Short label text only — logo upload is not available.
                            </div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(_validationError))
                        {
                            <Alert Type="@AlertType.Error" Message="@_validationError" ShowIcon="true" role="alert" />
                        }
                        @if (CanEdit)
                        {
                            <div style="display:flex;gap:8px;justify-content:flex-end;">
                                <Button OnClick="ResetFormFromLoaded" Disabled="_saving || _loading" AriaLabel="Reset profile form">
                                    Reset
                                </Button>
                                <Button Type="@ButtonType.Primary"
                                        OnClick="SaveAsync"
                                        Loading="_saving"
                                        Disabled="@(_saving || _loading || _concurrencyConflict)"
                                        AriaLabel="Save organization profile">
                                    Save
                                </Button>
                            </div>
                        }
                    </div>
                    <div class="hc-caption" style="margin-top:0.75rem;">
                        Permission: @WebPermissions.OrganizationProfileRead
                        @if (CanEdit)
                        {
                            <span> · @WebPermissions.OrganizationProfileUpdate</span>
                        }
                        · Version @_form.ExpectedVersion
                    </div>
                </div>
            </AntDesign.Col>
            <AntDesign.Col Xs="24" Lg="10">
                <div class="hc-card" style="margin-bottom:1rem;">
                    <h3 style="margin:0 0 0.75rem;font-size:1rem;">Usage &amp; limits</h3>
                    <Alert Type="@AlertType.Info"
                           Message="Limits are platform-enforced and read-only on this page."
                           ShowIcon="true"
                           Style="margin-bottom:0.75rem;" />
                    <AntDesign.Row Gutter="(16, 16)">
                        <AntDesign.Col Xs="12"><Statistic Title="Clinics used" Value="@_settings.ClinicCount" /></AntDesign.Col>
                        <AntDesign.Col Xs="12"><Statistic Title="Max clinics" Value="@_settings.MaxClinics" /></AntDesign.Col>
                        <AntDesign.Col Xs="12"><Statistic Title="Remaining clinics" Value="@_settings.RemainingClinicCapacity" /></AntDesign.Col>
                        <AntDesign.Col Xs="12"><Statistic Title="Staff used" Value="@_settings.StaffCount" /></AntDesign.Col>
                        <AntDesign.Col Xs="12"><Statistic Title="Max staff" Value="@_settings.MaxStaff" /></AntDesign.Col>
                        <AntDesign.Col Xs="12"><Statistic Title="Remaining staff" Value="@_settings.RemainingStaffCapacity" /></AntDesign.Col>
                    </AntDesign.Row>
                    <div style="margin-top:1rem;">
                        <Button Type="@ButtonType.Link" OnClick='() => Navigation.NavigateTo("/usage")' AriaLabel="Open usage and limits">
                            View full usage &amp; limits
                        </Button>
                    </div>
                </div>
            </AntDesign.Col>
        </AntDesign.Row>
    }
}

@code {
    private bool _loading;
    private bool _saving;
    private bool _timeZonesLoading;
    private bool _concurrencyConflict;
    private bool _subscribedPlatform;
    private string? _error;
    private string? _validationError;
    private string? _subtitle;
    private CancellationTokenSource? _cts;
    private OrganizationSettingsResponse? _settings;
    private OrganizationSettingsFormState _form = new();
    private List<TimeZoneInfoResponse> _timeZones = [];

    private bool CanEdit => OrganizationSettingsPermissionRules.CanUpdate(Permissions);

    private bool PlatformBypass =>
        Permissions.IsPlatformAdmin && PlatformTenant.ExplicitBypassEnabled;

    protected override async Task OnInitializedAsync()
    {
        if (Permissions.IsPatientOnly || !OrganizationSettingsPermissionRules.CanView(Permissions))
        {
            return;
        }

        if (Permissions.IsPlatformAdmin)
        {
            PlatformTenant.Changed += OnPlatformTenantChanged;
            _subscribedPlatform = true;
        }

        await LoadTimeZonesAsync();
        await LoadAsync();
    }

    public void Dispose()
    {
        if (_subscribedPlatform)
        {
            PlatformTenant.Changed -= OnPlatformTenantChanged;
        }

        _cts?.Cancel();
        _cts?.Dispose();
    }

    private void OnPlatformTenantChanged() => InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    private async Task LoadTimeZonesAsync()
    {
        _timeZonesLoading = true;
        try
        {
            _timeZones = (await ClinicsApi.ListTimeZonesAsync()).ToList();
            if (_timeZones.All(t => !string.Equals(t.TimeZoneId, "Asia/Riyadh", StringComparison.OrdinalIgnoreCase)))
            {
                _timeZones.Insert(0, new TimeZoneInfoResponse
                {
                    TimeZoneId = "Asia/Riyadh",
                    DisplayName = "Asia/Riyadh",
                    UtcOffset = "+03:00",
                });
            }
        }
        catch
        {
            _timeZones =
            [
                new TimeZoneInfoResponse { TimeZoneId = "Asia/Riyadh", DisplayName = "Asia/Riyadh", UtcOffset = "+03:00" },
                new TimeZoneInfoResponse { TimeZoneId = "UTC", DisplayName = "UTC", UtcOffset = "+00:00" },
            ];
        }
        finally
        {
            _timeZonesLoading = false;
        }
    }

    private async Task LoadAsync()
    {
        if (Permissions.IsPlatformAdmin && !PlatformTenant.HasOrganization)
        {
            _settings = null;
            _error = null;
            _validationError = null;
            _concurrencyConflict = false;
            return;
        }

        _cts?.Cancel();
        _cts?.Dispose();
        _cts = new CancellationTokenSource();
        _loading = true;
        _error = null;
        _validationError = null;
        _concurrencyConflict = false;

        try
        {
            var query = new OrganizationSettingsQuery
            {
                OrganizationId = Permissions.IsPlatformAdmin ? PlatformTenant.SelectedOrganizationId : null,
            };
            _settings = await SettingsApi.GetAsync(query, PlatformBypass, _cts.Token);
            _form = OrganizationSettingsFormState.FromResponse(_settings);
            _subtitle = _settings.Name;
        }
        catch (OperationCanceledException)
        {
        }
        catch (ApiProblemException ex)
        {
            _settings = null;
            _error = OrganizationSettingsProblemMessages.ToUserMessage(ex);
            Notify.Error(_error);
        }
        catch (Exception)
        {
            _settings = null;
            _error = "Unable to load organization profile settings.";
            Notify.Error(_error);
        }
        finally
        {
            _loading = false;
        }
    }

    private void ResetFormFromLoaded()
    {
        if (_settings is null)
        {
            return;
        }

        _form = OrganizationSettingsFormState.FromResponse(_settings);
        _validationError = null;
        _concurrencyConflict = false;
    }

    private async Task SaveAsync()
    {
        if (!CanEdit || _settings is null || _concurrencyConflict)
        {
            return;
        }

        var request = _form.TryBuildUpdateRequest(out var validationError);
        if (request is null)
        {
            _validationError = validationError;
            return;
        }

        _validationError = null;
        _saving = true;
        _error = null;

        try
        {
            var query = new OrganizationSettingsQuery
            {
                OrganizationId = Permissions.IsPlatformAdmin ? PlatformTenant.SelectedOrganizationId : null,
            };
            _settings = await SettingsApi.UpdateAsync(request, query, PlatformBypass);
            _form = OrganizationSettingsFormState.FromResponse(_settings);
            _subtitle = _settings.Name;
            _concurrencyConflict = false;
            Notify.Success("Organization profile saved.");
        }
        catch (ApiProblemException ex)
        {
            if (ex.StatusCode == 409
                || string.Equals(ex.ErrorCode, OrganizationSettingsErrorCodes.ConcurrencyConflict, StringComparison.Ordinal))
            {
                _concurrencyConflict = true;
            }

            _validationError = OrganizationSettingsProblemMessages.ToUserMessage(ex);
            Notify.Error(_validationError);
        }
        catch (Exception)
        {
            _validationError = "Unable to save organization profile settings.";
            Notify.Error(_validationError);
        }
        finally
        {
            _saving = false;
        }
    }
}
