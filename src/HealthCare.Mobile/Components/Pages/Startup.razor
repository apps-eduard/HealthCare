@page "/"
@inject IPatientAuthenticationService AuthService
@inject NavigationManager Nav
@inject ILogger<Startup> Logger

<LoadingState Message="Starting…" />

@if (_offline)
{
    <OfflineState Message="@_offlineMessage" OnRetry="RunAsync" />
    <p class="hint"><a href="@PatientRoutes.SignIn">Continue to sign in</a></p>
}

@code {
    private bool _offline;
    private string? _offlineMessage;

    protected override async Task OnInitializedAsync() => await RunAsync();

    private async Task RunAsync()
    {
        _offline = false;
        _offlineMessage = null;
        StateHasChanged();

        Logger.LogInformation("Startup session restore began.");
        var result = await AuthService.RestoreSessionAsync();

        switch (result.Status)
        {
            case SessionRestoreStatus.AuthenticatedPatient:
                Nav.NavigateTo(PatientRoutes.Home);
                break;
            case SessionRestoreStatus.OfflineWithTokens:
                _offline = true;
                _offlineMessage = result.Problem?.UserMessage
                    ?? "Unable to reach the server to verify your session.";
                break;
            default:
                Nav.NavigateTo(PatientRoutes.SignIn);
                break;
        }
    }
}
